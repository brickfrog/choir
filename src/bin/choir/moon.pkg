import {
  "choir/src/types",
  "choir/src/command",
  "choir/src/control",
  "choir/src/config",
  "choir/src/transport",
  "choir/src/sys",
  "choir/src/uds",
  "choir/src/exec/terminal",
  "choir/src/exec/conformance_host",
  "choir/src/exec/beads_host",
  "choir/src/exec/goal_host",
  "choir/src/exec/process_host",
  "choir/src/exec/provider_host",
  "choir/src/exec/doctor_host",
  "choir/src/exec/work_order_host",
  "choir/src/exec/conductor_host",
  "choir/src/mcp",
  "choir/src/prompts",
  "choir/src/workflow",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/ref",
  "moonbitlang/core/string",
  "moonbitlang/async",
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x/crypto",
  "brickfrog/moontrace",
}

pkgtype(kind: "executable")

options(
  targets: {
    "goal_cli.mbt": [ "native" ],
    "init.mbt": [ "native" ],
    "client.mbt": [ "native" ],
    "main.mbt": [ "native" ],
    "mcp_mode.mbt": [ "native" ],
    "start.mbt": [ "native" ],
    "stub_main.mbt": [ "not", "native" ],
    "uds_reader.mbt": [ "native" ],
    "server_native.mbt": [ "native" ],
    "statusline.mbt": [ "native" ],
  },
)
