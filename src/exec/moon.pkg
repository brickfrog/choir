import {
  "choir/src/sys",
  "choir/src/harness",
  "choir/src/exec/process_host",
  "choir/src/exec/provider_host",
  "choir/src/exec/take_host",
  "choir/src/sandbox",
  "choir/src/types",
  "moonbitlang/async",
  "moonbitlang/async/process",
  "moonbitlang/core/json",
  "moonbitlang/core/ref",
}

options(
  "is-main": false,
  "max-concurrent-tests": 1,
  targets: {
    "exec_native.mbt": [ "native" ],
    "exec_stub.mbt": [ "js", "wasm", "wasm-gc" ],
  },
)
